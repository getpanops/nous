{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^sources\\.yaml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\n]+)\\n\\s+version: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "{{datasource}}"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["sources.yaml"],
      "automerge": false,
      "labels": ["intel-update"],
      "commitMessageTopic": "intel source {{depName}}"
    }
  ]
}
